[Unit]
Description=Hipocrafy Edge AI Gateway
After=network.target ollama.service docker.service

[Service]
Type=simple
User=pmoraga
WorkingDirectory=/home/pmoraga/hipocrafy-edge
Environment="PATH=/home/pmoraga/hipocrafy-edge/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/pmoraga/hipocrafy-edge/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
