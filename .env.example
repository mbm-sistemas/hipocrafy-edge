# ═══════════════════════════════════════════════════════════
#  Hipocrafy Edge AI Gateway - Configuración
# ═══════════════════════════════════════════════════════════

# Nombre visible de este equipo en el dashboard local
GATEWAY_NAME=Nodo Local 01

# Token de autenticación generado en el panel de Admin de Hipocrafy Cloud
# Obtenerlo en: https://qas.hypocrafy.mbmsistemas.com.ar/admin/edge-gateways
GATEWAY_API_TOKEN=tu_token_aqui

# URL de la API de Hipocrafy Cloud (Edge Gateway endpoints)
HIPOCRAFY_CLOUD_URL=https://qas.hipocrafy-api.mbmsistemas.com.ar/api/edge-gateway

# Configuración de Orthanc (PACS local)
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=orthanc
