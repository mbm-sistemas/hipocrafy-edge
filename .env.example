# ═══════════════════════════════════════════════════════════
#  Hipocrafy Edge AI Gateway - Configuración
# ═══════════════════════════════════════════════════════════

# Nombre visible de este equipo en el dashboard local
GATEWAY_NAME=Nodo Local 01

# Token de autenticación generado en el panel de Admin de Hipocrafy Cloud
# Obtenerlo en: https://qas.hypocrafy.mbmsistemas.com.ar/admin/edge-gateways
GATEWAY_API_TOKEN=tu_token_aqui

# URL de la API de Hipocrafy Cloud (Edge Gateway endpoints)
HIPOCRAFY_CLOUD_URL=https://qas.hipocrafy-api.mbmsistemas.com.ar/api/edge-gateway

# Configuración de Orthanc (PACS local)
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASS=orthanc

# Password para acceder a /settings (panel de configuración del gateway)
# Sin este valor el sistema usa "hipocrafy" como password por defecto
SETTINGS_PASSWORD=cambiar_en_produccion

# Motor de IA activo: gemini | deepseek | ollama
# Si falla el motor activo, el sistema prueba los siguientes en orden automáticamente
ACTIVE_AI_ENGINE=gemini
GEMINI_API_KEY=tu_clave_gemini_aqui

# DeepSeek Cloud
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek Local (opcional): si DEEPSEEK_LOCAL_FIRST=true, intenta esta URL antes que la nube
# Útil cuando hay una instancia local de DeepSeek/Ollama compatible en el Jetson
DEEPSEEK_LOCAL_URL=http://localhost:8080/v1/chat/completions
DEEPSEEK_LOCAL_FIRST=false

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
