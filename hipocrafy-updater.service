[Unit]
Description=Hipocrafy Edge OTA Auto-Updater & Watchdog Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pmoraga/hipocrafy-edge
ExecStart=/home/pmoraga/hipocrafy-edge/venv/bin/python /home/pmoraga/hipocrafy-edge/auto_updater.py
User=pmoraga
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
